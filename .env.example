# 调试模式 (生产环境设为 False)
DEBUG=False

# Django 密钥（生产环境务必修改！）
SECRET_KEY=change-me-to-a-random-secret-key

# 允许的主机（逗号分隔）
ALLOWED_HOSTS=*

# 数据库引擎 (django.db.backends.sqlite3 或 django.db.backends.mysql)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# MySQL 配置（仅当 DB_ENGINE=django.db.backends.mysql 时需要）
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=followup_db
# DB_USER=followup_user
# DB_PASSWORD=dbpassword123
# DB_HOST=mysql
# DB_PORT=3306

# 超级管理员账号（容器启动时自动创建/更新）
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin123456

# MySQL root 密码（docker-compose 中 MySQL 容器用）
# MYSQL_ROOT_PASSWORD=root123
# MYSQL_PASSWORD=dbpassword123